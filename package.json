{
  "name": "@agentic.artists/openanalysis",
  "version": "0.2.1",
  "description": "A local BYOK MCP server that helps AI assistants choose models using OpenRouter ZDR endpoint data and Artificial Analysis benchmarks.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.AgenticArtists/openanalysis",
  "bin": {
    "openanalysis": "bin/openanalysis.js"
  },
  "files": [
    "bin/",
    "mcp/",
    "lib/",
    "config/",
    "scripts/setup.js",
    ".env.local.example",
    "ATTRIBUTION.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgenticArtists/OpenAnalysis.git"
  },
  "homepage": "https://github.com/AgenticArtists/OpenAnalysis#readme",
  "bugs": {
    "url": "https://github.com/AgenticArtists/OpenAnalysis/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "artificial-analysis",
    "llm",
    "model-selection",
    "zdr",
    "ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "test": "node --test",
    "check": "node --check bin/openanalysis.js && node --check lib/artificial-analysis.js && node --check lib/openrouter.js && node --check lib/match.js && node --check lib/catalog.js && node --check lib/http.js && node --check mcp/server.js && node --check scripts/setup.js",
    "pack:check": "npm pack --dry-run",
    "mcp": "node mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  }
}

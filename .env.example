# Required: Artificial Analysis Free API key
ARTIFICIAL_ANALYSIS_API_KEY=

# Required: OpenRouter API key
OPENROUTER_API_KEY=

# Required: a separate, revocable read-only token for this endpoint.
# ChatGPT will use this token in the ?access= query parameter.
MODEL_SELECTOR_ACCESS_TOKEN=

# Optional. 12 hours by default. In-memory cache is best-effort on serverless.
MODEL_SELECTOR_CACHE_TTL_MS=43200000
